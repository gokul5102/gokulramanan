---
import { sections, type SectionId } from '../site.ts';

interface Props {
  /** The section this page belongs to, marked as current in the navigation. */
  current?: SectionId;
}

const { current } = Astro.props;
---

<header class="wrap head">
  <a href="/" class="name">Gokul Ramanan</a>
  <nav class="nav" aria-label="Main">
    {
      sections.map((section) => (
        <a href={section.href} aria-current={section.id === current ? 'page' : undefined}>
          {section.label}
        </a>
      ))
    }
    <a href="/contact" class="cta">Get in touch</a>
  </nav>
</header>
