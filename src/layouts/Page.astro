---
import Footer from '../components/Footer.astro';
import Header from '../components/Header.astro';
import type { SectionId } from '../site.ts';
import '../styles/global.css';

interface Props {
  title: string;
  description: string;
  /** The header section this page belongs to. */
  section?: SectionId;
  /** False on the contact page, which already says "Say hello." */
  footerHeading?: boolean;
}

const { title, description, section, footerHeading = true } = Astro.props;
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <link rel="preload" href="/fonts/literata.woff2" as="font" type="font/woff2" crossorigin />
  </head>
  <body>
    <Header current={section} />
    <main class="wrap">
      <slot />
    </main>
    <Footer showHeading={footerHeading} />
  </body>
</html>
